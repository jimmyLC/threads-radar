[Unit]
Description=Threads Radar daily fetch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/radar
EnvironmentFile=/opt/radar/.env
Environment=RADAR_DB=/opt/radar/data/radar.db
Environment=RADAR_CONFIG_DIR=/opt/radar/config
ExecStart=/opt/radar/.venv/bin/python -m radar.fetch
