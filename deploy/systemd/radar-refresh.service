[Unit]
Description=Refresh Threads long-lived token (weekly)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/radar
EnvironmentFile=/opt/radar/.env
Environment=RADAR_DB=/opt/radar/data/radar.db
ExecStart=/opt/radar/.venv/bin/python -m radar.refresh
