# ==== Threads API（developers.facebook.com 建立 App 後填入）====
THREADS_APP_ID=
THREADS_APP_SECRET=
# 本機跑 OAuth 用；VPS 上透過 SSH 轉埠也用同一個值即可
THREADS_REDIRECT_URI=http://localhost:8899/callback

# ==== LLM（OpenAI 相容 API，用來做一行摘要）====
# 沒填的話系統照常運作，只是沒有摘要
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ==== 路徑與時區（通常不用改）====
# RADAR_DB=/opt/radar/data/radar.db
# RADAR_CONFIG_DIR=/opt/radar/config
TZ_OFFSET_HOURS=8
RETENTION_DAYS=365
